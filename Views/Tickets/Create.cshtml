@model AParCarWeb.Models.Ticket

@{
    ViewData["Title"] = "Nuevo Ticket";
}

<div style="height:30px;"></div>

<div class="container mt-4">

    <h2 class="mb-4">
        <i class="bi bi-ticket-perforated"></i>
        @ViewData["Title"]
    </h2>

    <form asp-action="Create"
          method="post"
          class="card shadow-lg p-4 rounded-4">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>

        <!-- =====================================================
             VEHÍCULO
        ====================================================== -->

        <div class="mb-3">

            <label asp-for="VehiculoId"
                   class="form-label fw-semibold">

                <i class="bi bi-car-front-fill"></i>
                Vehículo (Placa)

            </label>

            <select asp-for="VehiculoId"
                    class="form-select buscador"
                    asp-items="@(ViewData["VehiculoId"] as SelectList)">

                <option value="">
                    -- Buscar o seleccionar vehículo --
                </option>

            </select>

            <small class="text-muted">
                Puede escribir la placa para encontrarlo rápidamente.
            </small>

            <span asp-validation-for="VehiculoId"
                  class="text-danger">
            </span>

        </div>


        <!-- =====================================================
             ESPACIO
        ====================================================== -->

        <div class="mb-3">

            <label asp-for="EspacioId"
                   class="form-label fw-semibold">

                <i class="bi bi-p-square-fill"></i>
                Espacio disponible

            </label>

            <select asp-for="EspacioId"
                    class="form-select buscador"
                    asp-items="@(ViewData["EspacioId"] as SelectList)">

                <option value="">
                    -- Buscar o seleccionar espacio --
                </option>

            </select>

            <small class="text-muted">
                Filtre por código del espacio (Ej: A12, B05).
            </small>

            <span asp-validation-for="EspacioId"
                  class="text-danger">
            </span>

        </div>


        <!-- =====================================================
             INFORMACIÓN AUTOMÁTICA
        ====================================================== -->

        <div class="alert alert-info">

            <div class="d-flex align-items-center">

                <i class="bi bi-clock-history fs-3 me-3"></i>

                <div>

                    <strong>Hora de entrada automática</strong>

                    <br />

                    <span>
                        La fecha y hora de entrada se registrarán
                        automáticamente al guardar el ticket.
                    </span>

                </div>

            </div>

        </div>


        <!-- =====================================================
             ESTADO
        ====================================================== -->

        <div class="alert alert-success">

            <i class="bi bi-check-circle-fill"></i>

            El ticket se creará con estado:

            <strong>Activo</strong>

        </div>


        <!-- =====================================================
             BOTONES
        ====================================================== -->

        <div class="d-flex justify-content-between mt-4">

            <a href="javascript:history.back()"
               class="btn btn-outline-secondary px-4">

                <i class="bi bi-arrow-left"></i>
                Cancelar

            </a>

            <button type="submit"
                    class="btn btn-success px-4">

                <i class="bi bi-ticket-perforated"></i>
                Guardar ticket

            </button>

        </div>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <!-- =====================================================
         SELECT2
    ====================================================== -->

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css"
          rel="stylesheet" />

    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>

        $(document).ready(function() {

            $('.buscador').select2({

                placeholder: "Escriba para buscar...",

                allowClear: true,

                width: '100%'

            });

        });

    </script>
}